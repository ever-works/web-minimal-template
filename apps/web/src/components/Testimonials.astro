---
import { siteConfig } from '../config/site';
const { testimonials } = siteConfig;
---

<section data-component="testimonials" class="border-y border-border bg-muted/30 py-24 sm:py-28">
  <div class="mx-auto w-full max-w-6xl px-4 sm:px-6 lg:px-8">
    <div class="mx-auto max-w-2xl text-center">
      <p class="text-sm font-semibold text-primary">{testimonials.eyebrow}</p>
      <h2 class="mt-3 text-3xl font-bold tracking-tight sm:text-4xl">{testimonials.title}</h2>
    </div>

    <div class="mt-16 grid gap-6 md:grid-cols-3">
      {
        testimonials.items.map((t) => (
          <figure data-component="testimonial-card" class="flex flex-col rounded-2xl border border-border bg-card p-6">
            <blockquote class="flex-1 text-sm leading-relaxed">“{t.quote}”</blockquote>
            <figcaption class="mt-6">
              <div class="text-sm font-semibold">{t.author}</div>
              <div class="text-sm text-muted-foreground">{t.role}</div>
            </figcaption>
          </figure>
        ))
      }
    </div>
  </div>
</section>
