---
import { siteConfig } from '../config/site';
---

<section class="border-y border-border bg-muted/30 py-12">
  <div class="mx-auto w-full max-w-6xl px-4 sm:px-6 lg:px-8">
    <p class="text-center text-sm text-muted-foreground">Trusted by fast-moving teams</p>
    <div class="mt-8 flex flex-wrap items-center justify-center gap-x-10 gap-y-6 opacity-70">
      {
        siteConfig.logos.map((logo) => (
          <span class="text-lg font-semibold tracking-tight text-muted-foreground">{logo}</span>
        ))
      }
    </div>
  </div>
</section>
