---
import { siteConfig } from '../config/site';
const { steps } = siteConfig;
---

<section id="how-it-works" class="py-24 sm:py-28">
  <div class="mx-auto w-full max-w-6xl px-4 sm:px-6 lg:px-8">
    <div class="mx-auto max-w-2xl text-center">
      <p class="text-sm font-semibold text-primary">{steps.eyebrow}</p>
      <h2 class="mt-3 text-3xl font-bold tracking-tight sm:text-4xl">{steps.title}</h2>
      <p class="mt-4 text-muted-foreground">{steps.subtitle}</p>
    </div>

    <div class="mt-16 grid gap-8 sm:grid-cols-3">
      {
        steps.items.map((step, i) => (
          <div>
            <div class="grid h-10 w-10 place-items-center rounded-full bg-primary text-sm font-bold text-primary-foreground">
              {i + 1}
            </div>
            <h3 class="mt-5 text-lg font-semibold">{step.title}</h3>
            <p class="mt-2 text-sm text-muted-foreground">{step.description}</p>
          </div>
        ))
      }
    </div>
  </div>
</section>
