---
import { siteConfig } from '../config/site';
import Icon from './Icon.astro';
const { faq } = siteConfig;
---

<section id="faq" data-component="faq" class="py-24 sm:py-28">
  <div class="mx-auto w-full max-w-3xl px-4 sm:px-6 lg:px-8">
    <h2 class="text-center text-3xl font-bold tracking-tight sm:text-4xl">{faq.title}</h2>
    <div class="mt-12 divide-y divide-border rounded-2xl border border-border bg-card">
      {
        faq.items.map((item) => (
          <details data-component="faq-item" class="group" name="faq">
            <summary class="flex cursor-pointer list-none items-center justify-between gap-4 px-6 py-5 font-medium">
              {item.question}
              <Icon
                name="chevron-down"
                class="h-5 w-5 shrink-0 text-muted-foreground transition-transform group-open:rotate-180"
              />
            </summary>
            <p class="px-6 pb-5 text-sm text-muted-foreground">{item.answer}</p>
          </details>
        ))
      }
    </div>
  </div>
</section>
