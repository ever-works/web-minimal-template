---
import { siteConfig } from '../config/site';
import Icon from './Icon.astro';
const { pricing } = siteConfig;
---

<section id="pricing" data-component="pricing" class="py-24 sm:py-28">
  <div class="mx-auto w-full max-w-6xl px-4 sm:px-6 lg:px-8">
    <div class="mx-auto max-w-2xl text-center">
      <p class="text-sm font-semibold text-primary">{pricing.eyebrow}</p>
      <h2 class="mt-3 text-3xl font-bold tracking-tight sm:text-4xl">{pricing.title}</h2>
      <p class="mt-4 text-muted-foreground">{pricing.subtitle}</p>
    </div>

    <div class="mx-auto mt-16 grid max-w-5xl gap-6 lg:grid-cols-3">
      {
        pricing.plans.map((plan) => (
          <div
            data-component="pricing-card"
            data-featured={plan.highlighted ? '' : undefined}
            class:list={[
              'flex flex-col rounded-2xl border p-8',
              plan.highlighted
                ? 'border-primary bg-card shadow-lg ring-1 ring-primary'
                : 'border-border bg-card'
            ]}
          >
            {plan.highlighted && (
              <span class="mb-4 inline-flex w-fit rounded-full bg-primary px-3 py-1 text-xs font-semibold text-primary-foreground">
                Most popular
              </span>
            )}
            <h3 class="text-lg font-semibold">{plan.name}</h3>
            <div class="mt-4 flex items-baseline gap-1">
              <span class="text-4xl font-bold tracking-tight">{plan.price}</span>
              {plan.period && <span class="text-sm text-muted-foreground">{plan.period}</span>}
            </div>
            <p class="mt-3 text-sm text-muted-foreground">{plan.description}</p>
            <ul class="mt-6 space-y-3">
              {plan.features.map((f) => (
                <li class="flex items-start gap-2 text-sm">
                  <Icon name="check" class="mt-0.5 h-4 w-4 shrink-0 text-primary" />
                  <span>{f}</span>
                </li>
              ))}
            </ul>
            <a
              href={plan.cta.href}
              class:list={[
                'mt-8 inline-flex h-11 w-full items-center justify-center rounded-lg px-5 text-sm font-medium transition-colors',
                plan.highlighted
                  ? 'bg-primary text-primary-foreground hover:opacity-90'
                  : 'border border-border bg-muted text-foreground hover:bg-border'
              ]}
            >
              {plan.cta.label}
            </a>
          </div>
        ))
      }
    </div>
  </div>
</section>
