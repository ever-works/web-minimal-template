---
import { siteConfig } from '../config/site';
---

<footer class="border-t border-border bg-muted/40">
  <div class="mx-auto w-full max-w-6xl px-4 py-14 sm:px-6 lg:px-8">
    <div class="grid gap-10 md:grid-cols-[1.5fr_repeat(3,1fr)]">
      <div>
        <a href="/" class="flex items-center gap-2 font-semibold">
          <span class="grid h-8 w-8 place-items-center rounded-lg bg-primary text-primary-foreground">
            {siteConfig.name.charAt(0)}
          </span>
          <span class="text-lg">{siteConfig.name}</span>
        </a>
        <p class="mt-4 max-w-xs text-sm text-muted-foreground">{siteConfig.description}</p>
      </div>

      {
        siteConfig.footer.columns.map((col) => (
          <div>
            <h3 class="text-sm font-semibold">{col.title}</h3>
            <ul class="mt-4 space-y-3">
              {col.links.map((link) => (
                <li>
                  <a
                    href={link.href}
                    class="text-sm text-muted-foreground transition-colors hover:text-foreground"
                  >
                    {link.label}
                  </a>
                </li>
              ))}
            </ul>
          </div>
        ))
      }
    </div>

    <div
      class="mt-12 flex flex-col items-center justify-between gap-4 border-t border-border pt-8 sm:flex-row"
    >
      <p class="text-sm text-muted-foreground">{siteConfig.footer.legal}</p>
      <div class="flex gap-5">
        {
          siteConfig.footer.social.map((s) => (
            <a
              href={s.href}
              target="_blank"
              rel="noopener noreferrer"
              class="text-sm text-muted-foreground transition-colors hover:text-foreground"
            >
              {s.label}
            </a>
          ))
        }
      </div>
    </div>
  </div>
</footer>
